---
import "@fontsource-variable/onest";
import onestLatin from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import { languages } from "@/i18n/ui";
import { absoluteUrl, getLang, ogLocale, otherLang, useTranslations } from "@/i18n/utils";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  /** Markdown copy of this page, for language models */
  markdown?: string;
}

const {
  description,
  title,
  image,
  noindex = false,
  markdown,
} = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const alternate = otherLang(lang);
const canonical = absoluteUrl(lang);

const siteUrl = "https://mrdieggo.dev";
// JPG, not WebP: some link previews (LinkedIn among them) skip WebP images
const ogImage = new URL(image ?? (lang === "en" ? "/og-en.jpg" : "/og.jpg"), siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Diego Gabriel Molina Rodríguez",
  alternateName: "mr-dieggo",
  url: siteUrl,
  sameAs: [
    "https://linkedin.com/in/diego-molinar",
    "https://github.com/mr-dieggo",
  ],
  jobTitle: t("meta.jobTitle"),
  knowsLanguage: Object.keys(languages),
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidad de Los Lagos",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Osorno",
    addressCountry: "CL",
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Diego Molina Rodríguez" />
    <meta name="generator" content={Astro.generator} />

    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={absoluteUrl("es")} />
        <link rel="alternate" hreflang="en" href={absoluteUrl("en")} />
        <link rel="alternate" hreflang="x-default" href={absoluteUrl("es")} />
      </>
    )}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[alternate]} />
    <meta property="og:site_name" content={t("meta.siteName")} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Apply the saved theme before first paint, so there is no light flash -->
    <script is:inline>
      (() => {
        let stored = null
        try {
          stored = localStorage.getItem("theme")
        } catch {}
        const pref = stored === "light" || stored === "dark" ? stored : "system"
        const dark =
          pref === "dark" ||
          (pref === "system" && matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.classList.toggle("dark", dark)
        document.documentElement.dataset.themePref = pref
      })()
    </script>

    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="darkreader-lock" />
    <ViewTransitions />
  </head>

  <body class="relative text-black dark:text-white bg-gray-50 dark:bg-gray-950">
    <div
      class="fixed inset-0 z-[-2] bg-gray-50 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(251,191,36,0.14),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(251,191,36,0.08),rgba(0,0,0,0))]"
    >
    </div>
    <!-- Grain texture overlay for tactile depth -->
    <div
      class="pointer-events-none fixed inset-0 z-[-1] opacity-[0.035] dark:opacity-[0.05]"
      style="background-image: url('/noise.svg'); background-size: 200px 200px;"
      aria-hidden="true"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: light dark;
      }

      /* Theme icons: show only the saved preference until the toggle script runs */
      .theme-toggle-icon {
        scale: 0;
      }
      html[data-theme-pref="light"] #light,
      html[data-theme-pref="dark"] #dark,
      html[data-theme-pref="system"] #system {
        scale: 1;
      }

      ::selection {
        background-color: rgb(250 204 21 / 0.35);
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      @media (prefers-color-scheme: dark) {
        body {
          color: rgba(255, 255, 255, 0.9);
        }
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgb(229, 229, 229);
          border-radius: 9999px;
        }
      }

      @media (prefers-color-scheme: dark) {
        @keyframes blur {
          from {
            border: 0px;
          }
          to {
            box-shadow:
              0px 5px 50px -5px rgba(0, 0, 0, 0.1),
              0px 0px 0 1px rgba(0, 0, 0, 0.3);
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(20px);
            border-width: 1px;
            border-color: rgba(0, 0, 0);
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.3);
            border-radius: 9999px;
          }
        }
      }

      /* ── Design system: staggered entrance animations ─────────────── */
      @keyframes fade-in-up {
        from {
          opacity: 0;
          translate: 0 20px;
        }
        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      .anim-fade-in {
        animation: fade-in-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .anim-delay-1 { animation-delay: 120ms; }
      .anim-delay-2 { animation-delay: 260ms; }
      .anim-delay-3 { animation-delay: 400ms; }
      .anim-delay-4 { animation-delay: 540ms; }

      /* Gradient text utility for the hero name */
      .gradient-name {
        background: linear-gradient(135deg, #b45309 10%, #c2410c 90%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
      }

      .dark .gradient-name {
        background-image: linear-gradient(135deg, #f59e0b 10%, #f97316 90%);
      }

      /* Scroll-triggered reveal for named sections (below the fold) */
      @supports (animation-timeline: view()) {
        [data-section] {
          animation: fade-in-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
          animation-timeline: view();
          animation-range: entry 0% entry 18%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .anim-fade-in,
        [data-section] {
          animation: none !important;
          opacity: 1 !important;
          translate: none !important;
        }
      }
    </style>
  </body>
</html>
