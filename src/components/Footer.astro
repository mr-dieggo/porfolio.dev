---
import HeartFilled from "./icons/HeartFilled.astro"
import { getLang, useTranslations } from "@/i18n/utils"

const t = useTranslations(getLang(Astro.currentLocale))
const currentYear = new Date().getFullYear()
---

<footer
  class="opacity-80 mt-16 mb-10 w-full mx-auto px-4 container lg:max-w-4xl md:max-w-2xl flex justify-center"
>
  <div
    class="rounded-lg w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between py-4 flex flex-col md:flex-row items-center gap-4"
  >
    <span class="text-sm text-center text-pretty md:text-left text-zinc-800/90 dark:text-zinc-200/90"
      >&copy; {currentYear}
      <a href="https://github.com/mr-dieggo/porfolio.dev" class="hover:underline">Diego Molina</a>.
      {t("footer.madeWith")} <HeartFilled class="size-3.5 text-red-500 inline" aria-hidden="true" /><span class="sr-only">{t("footer.love")}</span>
      {t("footer.template")} <a href="https://midu.dev/" class="hover:underline">midudev</a>.
    </span>
  </div>
</footer>
