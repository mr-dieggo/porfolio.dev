---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Python from "./icons/Python.astro"
import Qt from "./icons/Qt.astro"
import ReactIcon from "./icons/React.astro"
import NodeJS from "./icons/NodeJS.astro"
import Express from "./icons/Express.astro"
import MySQL from "./icons/MySQL.astro"
import TypeScript from "./icons/TypeScript.astro"
import AstroLogo from "./icons/AstroLogo.astro"
import Go from "./icons/Go.astro"
import Expo from "./icons/Expo.astro"
import PostgreSQL from "./icons/PostgreSQL.astro"
import Vite from "./icons/Vite.astro"
import GoogleCloud from "./icons/GoogleCloud.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import projectsData from "@/data/projects.json"

const TAGS: Record<string, { name: string; class: string; icon: any }> = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white",
    icon: Python,
  },
  QT: {
    name: "PySide6 (Qt)",
    class: "bg-[#41CD52] text-black",
    icon: Qt,
  },
  REACT: {
    name: "React",
    class: "bg-[#20232a] text-[#61DAFB]",
    icon: ReactIcon,
  },
  NODE: {
    name: "Node.js",
    class: "bg-[#215732] text-white",
    icon: NodeJS,
  },
  EXPRESS: {
    name: "Express",
    class: "bg-[#404040] text-white",
    icon: Express,
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-[#00546B] text-white",
    icon: MySQL,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-[#3178C6] text-white",
    icon: TypeScript,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-[#17191e] text-white",
    icon: AstroLogo,
  },
  GO: {
    name: "Go",
    class: "bg-[#00ADD8] text-black",
    icon: Go,
  },
  EXPO: {
    name: "Expo",
    class: "bg-black text-white",
    icon: Expo,
  },
  POSTGRESQL: {
    name: "PostgreSQL",
    class: "bg-[#336791] text-white",
    icon: PostgreSQL,
  },
  VITE: {
    name: "Vite",
    class: "bg-[#1e1b4b] text-[#FFD62E]",
    icon: Vite,
  },
  GOOGLECLOUD: {
    name: "Google Cloud",
    class: "bg-[#1A73E8] text-white",
    icon: GoogleCloud,
  },
}

const PROJECTS = projectsData.map((project) => ({
  ...project,
  tags: project.tags.map((key) => TAGS[key]),
}))
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github, note }, index) => (
    <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(251,191,36,0.2)] lg:border lg:border-gray-800 lg:hover:border-yellow-400/30 lg:hover:bg-gray-800/50">
      <img
        alt={title}
        width="1200"
        height="750"
        class="object-cover object-top w-full h-auto aspect-[16/10] transition duration-500 md:scale-110 md:group-hover:scale-105"
        loading={index < 2 ? "eager" : "lazy"}
        decoding="async"
        src={image}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <ul class="flex flex-row flex-wrap mt-3 gap-2">
      {tags.map((tag) => (
        <li>
          <span
            class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
          >
            <tag.icon class="size-4" aria-hidden="true" />
            {tag.name}
          </span>
        </li>
      ))}
    </ul>

    <p class="mt-3 text-gray-700 dark:text-gray-400 text-pretty">{description}</p>
    <footer class="flex items-center mt-4 gap-x-4">
      {github && (
        <LinkButton href={github}>
          <GitHub class="size-5" />
          Código
        </LinkButton>
      )}
      {link && (
        <LinkButton href={link}>
          <ExternalLink class="size-4" />
          Ver demo
        </LinkButton>
      )}
      {note && (
        <span class="text-sm font-mono text-gray-500 dark:text-gray-400">{note}</span>
      )}
    </footer>
  </div>
</article>
    ))
  }
</div>



