---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Python from "./icons/Python.astro"
import Qt from "./icons/Qt.astro"
import ReactIcon from "./icons/React.astro"
import NodeJS from "./icons/NodeJS.astro"
import Express from "./icons/Express.astro"
import MySQL from "./icons/MySQL.astro"
import TypeScript from "./icons/TypeScript.astro"
import AstroLogo from "./icons/AstroLogo.astro"
import Go from "./icons/Go.astro"
import Expo from "./icons/Expo.astro"
import PostgreSQL from "./icons/PostgreSQL.astro"
import Vite from "./icons/Vite.astro"
import GoogleCloud from "./icons/GoogleCloud.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import { projects, type ProjectEntry } from "@/data/projects"
import { getLang, useTranslations } from "@/i18n/utils"

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)

const TAGS: Record<string, { name: string; class: string; icon: any }> = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white",
    icon: Python,
  },
  QT: {
    name: "PySide6 (Qt)",
    class: "bg-[#41CD52] text-black",
    icon: Qt,
  },
  REACT: {
    name: "React",
    class: "bg-[#20232a] text-[#61DAFB]",
    icon: ReactIcon,
  },
  NODE: {
    name: "Node.js",
    class: "bg-[#215732] text-white",
    icon: NodeJS,
  },
  EXPRESS: {
    name: "Express",
    class: "bg-[#404040] text-white",
    icon: Express,
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-[#00546B] text-white",
    icon: MySQL,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-[#3178C6] text-white",
    icon: TypeScript,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-[#17191e] text-white",
    icon: AstroLogo,
  },
  GO: {
    name: "Go",
    class: "bg-[#00ADD8] text-black",
    icon: Go,
  },
  EXPO: {
    name: "Expo",
    class: "bg-black text-white",
    icon: Expo,
  },
  POSTGRESQL: {
    name: "PostgreSQL",
    class: "bg-[#336791] text-white",
    icon: PostgreSQL,
  },
  VITE: {
    name: "Vite",
    class: "bg-[#1e1b4b] text-[#FFD62E]",
    icon: Vite,
  },
  GOOGLECLOUD: {
    name: "Google Cloud",
    class: "bg-[#1A73E8] text-white",
    icon: GoogleCloud,
  },
}

const PROJECTS = (projects as ProjectEntry[]).map((project) => ({
  ...project,
  title: project.title[lang],
  description: project.description[lang],
  note: project.note?.[lang],
  image: project.image?.[lang],
  tags: project.tags.map((key) => TAGS[key]),
}))

const FEATURED = PROJECTS.filter((project) => !project.experiment)
const EXPERIMENTS = PROJECTS.filter((project) => project.experiment)
---

<div class="flex flex-col gap-y-12 md:gap-y-16">
  {
    FEATURED.map(({ image, title, description, tags, link, github, note }, index) => (
    <article class="flex flex-col space-x-0 space-y-4 group md:flex-row md:space-x-10 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(251,191,36,0.2)] lg:border lg:border-gray-800 lg:hover:border-yellow-400/30 lg:hover:bg-gray-800/50">
      <img
        alt={title}
        width="1200"
        height="750"
        class="object-cover object-center w-full h-auto aspect-[2/1] md:object-top md:aspect-[16/10] transition duration-500 md:scale-110 md:group-hover:scale-105"
        loading={index < 2 ? "eager" : "lazy"}
        decoding="async"
        src={image}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
    <h3 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <p class="mt-2 text-xs font-medium text-gray-500 dark:text-gray-400 md:hidden">
      {tags.map((tag) => tag.name).join(" · ")}
    </p>
    <ul class="hidden md:flex flex-row flex-wrap mt-3 gap-2">
      {tags.map((tag) => (
        <li>
          <span
            class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
          >
            <tag.icon class="size-4" aria-hidden="true" />
            {tag.name}
          </span>
        </li>
      ))}
    </ul>

    <p
      id={`project-desc-${index}`}
      class="project-desc mt-3 text-gray-700 dark:text-gray-400 text-pretty"
    >
      {description}
    </p>
    <button
      type="button"
      aria-controls={`project-desc-${index}`}
      aria-expanded="false"
      data-more={t("projects.readMore")}
      data-less={t("projects.readLess")}
      class="project-desc-toggle hidden self-start mt-1 text-sm font-medium text-amber-700 dark:text-yellow-200 hover:underline underline-offset-4 rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-yellow-500"
    >
      {t("projects.readMore")}
    </button>
    <footer class="flex flex-wrap items-center mt-4 gap-x-4 gap-y-2">
      {github && (
        <LinkButton href={github}>
          <GitHub class="size-5" />
          {t("projects.code")}
        </LinkButton>
      )}
      {link && (
        <LinkButton href={link}>
          <ExternalLink class="size-4" />
          {t("projects.demo")}
        </LinkButton>
      )}
      {note && (
        <span class="text-sm font-mono text-gray-500 dark:text-gray-400">{note}</span>
      )}
    </footer>
  </div>
</article>
    ))
  }
</div>

{
  EXPERIMENTS.length > 0 && (
    <div class="mt-16">
      <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100">{t("projects.experiments")}</h3>
      <ul class="mt-2 divide-y divide-gray-200 dark:divide-white/10">
        {EXPERIMENTS.map(({ title, description, tags, link, github }) => (
          <li class="flex flex-col gap-3 py-5 md:flex-row md:items-center md:justify-between md:gap-8">
            <div class="max-w-lg">
              <h4 class="font-semibold text-gray-800 dark:text-gray-100">{title}</h4>
              <p class="mt-1 text-sm text-gray-700 dark:text-gray-400 text-pretty">{description}</p>
              <p class="mt-2 text-xs font-medium text-gray-500 dark:text-gray-400">
                {tags.map((tag) => tag.name).join(" · ")}
              </p>
            </div>
            <div class="flex gap-3 shrink-0">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-5" />
                  {t("projects.code")}
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <ExternalLink class="size-4" />
                  {t("projects.demo")}
                </LinkButton>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  // On phones, long descriptions start at three lines with a "read more"
  // toggle. Without JS (or on wider screens) the full text stays visible.
  document.addEventListener("astro:page-load", () => {
    if (!window.matchMedia("(max-width: 767px)").matches) return

    document.querySelectorAll<HTMLParagraphElement>(".project-desc").forEach((desc) => {
      const toggle = desc.nextElementSibling as HTMLButtonElement | null
      if (!toggle?.classList.contains("project-desc-toggle")) return

      desc.classList.add("line-clamp-3")
      if (desc.scrollHeight <= desc.clientHeight + 1) {
        desc.classList.remove("line-clamp-3")
        return
      }

      toggle.classList.remove("hidden")
      toggle.addEventListener("click", () => {
        const expanded = desc.classList.toggle("line-clamp-3") === false
        toggle.setAttribute("aria-expanded", String(expanded))
        toggle.textContent = (expanded ? toggle.dataset.less : toggle.dataset.more) ?? ""
      })
    })
  })
</script>
