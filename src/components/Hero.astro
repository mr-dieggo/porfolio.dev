---
import Badge from "@/components/Badge.astro"
import DownloadIcon from "@/components/icons/Download.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import FlagChile from "@/components/icons/FlagChile.astro"
import SocialPill from "@/components/SocialPill.astro"
import { getLang, rich, useTranslations } from "@/i18n/utils"

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
---

<div class="max-w-xl">
  <div class="anim-fade-in flex gap-4 mb-6 items-center">
    <!-- Avatar with ambient glow -->
    <div class="relative flex-shrink-0">
      <div
        class="absolute inset-0 rounded-full bg-yellow-400/30 dark:bg-yellow-400/20 blur-xl scale-125"
        aria-hidden="true"
      >
      </div>
      <img
        class="relative rounded-full shadow-2xl size-20 ring-2 ring-yellow-400/60 ring-offset-2 ring-offset-gray-50 dark:ring-offset-gray-950"
        src="/avatar.webp"
        width="80"
        height="80"
        alt={t("hero.avatarAlt")}
      />
    </div>
    <Badge>{t("hero.available")}</Badge>
  </div>

  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {t("hero.greeting")} <span class="gradient-name">Diego Molina</span>
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-amber-700 [&>strong]:font-semibold dark:text-gray-300"
  >
    <strong>{t("hero.role")}</strong> {t("hero.from")}
    <FlagChile class="inline-block h-[0.75em] w-auto -translate-y-px rounded-[2px] ring-1 ring-black/10" aria-hidden="true" />.
    <Fragment set:html={rich(t("hero.summary"))} />
  </p>

  <p class="anim-fade-in anim-delay-2 mt-3 text-lg text-gray-700 dark:text-gray-400 text-pretty">
    {t("hero.seeking")}
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8"
    aria-label={t("hero.linksLabel")}
  >
    <SocialPill href="#contacto" primary>
      <MailIcon class="size-4" />
      {t("hero.contact")}
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/diego-molinar">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/mr-dieggo">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
    <SocialPill href={t("cv.href")} type="application/pdf" hreflang={lang}>
      <DownloadIcon class="size-4" />
      {t("cv.label")}
    </SocialPill>
  </nav>
</div>
