---
import ThemeToggle from "./ThemeToggle.astro"
import LanguageSwitch from "./LanguageSwitch.astro"
import { sections } from "@/data/sections"
import { getLang, localeHome, useTranslations } from "@/i18n/utils"

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const home = localeHome(lang)

const navItems = sections.map(({ id, nav }) => ({
  title: t(nav),
  label: id,
  url: `${home}#${id}`,
}))
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4"
>
  <nav
    class="header-nav flex gap-x-0 min-[400px]:gap-x-0.5 sm:gap-x-1 px-1.5 sm:px-4 py-1.5 text-sm font-medium rounded-full text-gray-600 dark:text-gray-300 justify-center items-center border border-transparent"
  >
    {
      navItems.map((link) => (
        <a
          class={`nav-link relative whitespace-nowrap text-xs sm:text-sm block px-1 min-[400px]:px-1.5 sm:px-3 py-2 sm:py-1.5 rounded-full transition-colors duration-200 hover:text-amber-700 dark:hover:text-yellow-400 ${link.label === "sobre-mi" ? "max-[469px]:hidden" : ""}`}
          data-section-link={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <div class="flex items-center gap-0.5 min-[400px]:gap-1 ml-0.5 pl-1 min-[400px]:ml-1 min-[400px]:pl-1.5 sm:ml-2 sm:pl-2 border-l border-gray-300/30 dark:border-white/10">
      <LanguageSwitch />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a[data-section-link]")
    const langSwitch = document.querySelector<HTMLAnchorElement>("[data-lang-switch]")

    const lastSection = sections[sections.length - 1]

    const setActive = (id: string) => {
      // Keep the language switch pointing at the section being read
      if (langSwitch) {
        const base = langSwitch.dataset.base ?? "/"
        langSwitch.href = id ? `${base}#${id}` : base
      }
      navItems.forEach((item) => {
        if (item.getAttribute("data-section-link") == id) {
          item.classList.add("text-amber-700", "dark:text-yellow-400", "bg-yellow-400/10")
          item.classList.remove("text-gray-600", "dark:text-gray-300")
        } else {
          item.classList.remove("text-amber-700", "dark:text-yellow-400", "bg-yellow-400/10")
          item.classList.add("text-gray-600", "dark:text-gray-300")
        }
      })
    }

    // The last section is too short to reach the middle band, so it wins
    // whenever the page is scrolled to the bottom
    const isAtBottom = () =>
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2

    const callback = (entries: IntersectionObserverEntry[]) => {
      if (isAtBottom() && lastSection) {
        setActive(lastSection.id)
        return
      }
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id)
      })
    }

    // A thin band near the middle of the viewport, so sections taller than the
    // screen still become active (a ratio threshold never fires for them).
    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "-40% 0px -55% 0px",
      threshold: 0,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    window.addEventListener(
      "scroll",
      () => {
        if (isAtBottom() && lastSection) setActive(lastSection.id)
      },
      { passive: true },
    )

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  .header-nav {
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  .header-nav {
    @apply dark:bg-gray-900/80 bg-white/60;
  }

  .nav-link.text-amber-700 {
    @apply font-semibold;
  }

  @keyframes nav-appear {
    0% {
      @apply dark:bg-gray-900/0 bg-white/0 border-transparent shadow-none;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur-md ring-white/10 dark:ring-white/5 border-gray-200/20 dark:border-white/5;
    }
  }
</style>
