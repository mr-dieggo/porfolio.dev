---
import ThemeToggle from "./ThemeToggle.astro"

const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "/#contacto",
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4"
>
  <nav
    class="header-nav flex gap-x-1 px-4 py-1.5 text-sm font-medium rounded-full text-gray-600 dark:text-gray-300 justify-center items-center border border-transparent"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative text-xs sm:text-sm block px-1.5 sm:px-3 py-2 sm:py-1.5 rounded-full transition-colors duration-200 hover:text-amber-700 dark:hover:text-yellow-400"
          data-section-link={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <div class="ml-2 pl-2 border-l border-gray-300/30 dark:border-white/10">
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")

    const lastSection = sections[sections.length - 1]

    const setActive = (id: string) => {
      navItems.forEach((item) => {
        if (item.getAttribute("data-section-link") == id) {
          item.classList.add("text-amber-700", "dark:text-yellow-400", "bg-yellow-400/10")
          item.classList.remove("text-gray-600", "dark:text-gray-300")
        } else {
          item.classList.remove("text-amber-700", "dark:text-yellow-400", "bg-yellow-400/10")
          item.classList.add("text-gray-600", "dark:text-gray-300")
        }
      })
    }

    // The last section is too short to reach the middle band, so it wins
    // whenever the page is scrolled to the bottom
    const isAtBottom = () =>
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2

    const callback = (entries: IntersectionObserverEntry[]) => {
      if (isAtBottom() && lastSection) {
        setActive(lastSection.id)
        return
      }
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id)
      })
    }

    // A thin band near the middle of the viewport, so sections taller than the
    // screen still become active (a ratio threshold never fires for them).
    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "-40% 0px -55% 0px",
      threshold: 0,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    window.addEventListener(
      "scroll",
      () => {
        if (isAtBottom() && lastSection) setActive(lastSection.id)
      },
      { passive: true },
    )

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  .header-nav {
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  .header-nav {
    @apply dark:bg-gray-900/80 bg-white/60;
  }

  .nav-link.text-amber-700 {
    @apply font-semibold;
  }

  @keyframes nav-appear {
    0% {
      @apply dark:bg-gray-900/0 bg-white/0 border-transparent shadow-none;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur-md ring-white/10 dark:ring-white/5 border-gray-200/20 dark:border-white/5;
    }
  }
</style>
